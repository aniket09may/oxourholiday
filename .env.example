# Existing Supabase connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Recommended for locked-down Row Level Security on admin operations.
# Keep this server-only and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin access
ADMIN_PASSCODE=replace-with-a-strong-admin-passcode
SALES_PASSCODE=replace-with-a-strong-sales-passcode
SESSION_SECRET=replace-with-at-least-32-random-characters

# Lead email notifications
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=Oxour Holiday <leads@your-verified-domain.com>
LEAD_NOTIFICATION_EMAIL=sales@oxourholiday.com
